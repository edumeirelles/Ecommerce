@model DAL.ViewModels.ProductViewModel

<h1 class="mb-5">@Html.Raw(Model.Title)</h1>

<form asp-action="EditProduct" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label" asp-for="ProductImages"></label>
        </div>
        <div class="col">
            <div class="row">
                @for (var i = 0; i < Model.ProductImages.Count(); i++)
                {
                    @Html.HiddenFor(x=> x.ProductImages[i].Id)
                    <div class="col-2 ">
                        <div class="card w-100">
                            <div class="card-body p-0">
                                <img src="@Url.Content(Model.ProductImages[i].ImagePath)" class="product-image" />
                            </div>
                            <div class="card-footer d-inline-flex" style="padding:10px">
                                <label class="col-form-label me-1"><small>Ordem:</small></label>
                                @Html.EditorFor(x => x.ProductImages[i].Order, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="row" id="add-new-image">
                <div class="col-3">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addNewImage()">Adicionar imagem</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row my-3">
        <div class="col-2">
            <label class="col-form-label" asp-for="Title"></label>
        </div>
        <div class="col">
            <input class="form-control" type="text" asp-for="Title" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label" asp-for="FullDescription"></label>
        </div>
        <div class="col">
            <textarea class="form-control" asp-for="FullDescription" rows="10"></textarea>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label" asp-for="SmallDescription"></label>
        </div>
        <div class="col">
            <textarea class="form-control" asp-for="SmallDescription" rows="5"></textarea>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label" asp-for="Price"></label>
        </div>
        <div class="col-2">
            <input class="form-control" asp-for="Price" type="number" step="any" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label" asp-for="Details"></label>
        </div>

        <div class="col align-items-center d-inline-block" id="div-detail-row">
            @if (Model.Details?.Count > 0)
            {
                <div class="row mb-2 text-center" id="detail-header">

                    <div class="col-1">
                    </div>
                    <div class="col-5">
                        <label class="small">Título do detalhe</label>
                    </div>
                    <div class="col-5">
                        <label class="small">Descrição</label>
                    </div>
                    <div class="col-1">
                    </div>

                </div>
                @for (var i = 0; i < Model.Details.Count; i++)
                {
                    <div class="row mb-3 detail-row">
                        <div class="col-1">
                            <span class="row-number">@(i + 1).</span>
                        </div>
                        <div class="col-5">
                            @Html.EditorFor(x => x.Details[i].Key, new { htmlAttributes = new { @class = "form-control me-1 row-key" } })
                        </div>
                        <div class="col-5">
                            @Html.EditorFor(x => x.Details[i].Value, new { htmlAttributes = new { @class = "form-control me-1 row-value" } })
                        </div>
                        <div class="col-1 remove-detail-row">
                            <button type="button" class="btn btn-lg"><i class="m-2 ti ti-trash"></i></button>
                        </div>
                    </div>
                }
            }
           
            <div class="row" id="add-new-detail-row">
                <div class="col-3">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addDetail()">Adicionar detalhe</button>
                </div>
            </div>
            <hr />
        </div>

    </div>
    <div class="row">
        <div class="col-2">            
        </div>
        <div class="col d-flex  justify-content-evenly">
            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-danger">Voltar</a>
            <input type="submit" value="Salvar" class="btn btn-outline-primary" />           
        </div>
    </div>
</form>

@section Scripts {
    <script type="text/javascript">


        $(document).ready(function(){
            $("form").on("click",".remove-detail-row", function(){
                $(this).parent().remove();
                var detailRowIndex = $(".detail-row").length;
                if(detailRowIndex == 0){
                    console.log("bla")
                    $("#detail-header").remove();
                };
                updateRowsIndexes();
            });
        });

        function addDetail(){
            var detailRowIndex = $(".detail-row").length;

            var newDetailRowHtml = `
                                    <div class="row mb-3 detail-row ">
                                        <div class="col-1">
                                            <span class="row-number">${detailRowIndex + 1}.</span>
                                        </div>
                                        <div class="col-5">
                                            <input class="form-control me-1 row-key" name="Details[${detailRowIndex}].Key" type="text" value="" />
                                        </div>
                                        <div class="col-5">
                                            <input class="form-control me-1 row-value" name="Details[${detailRowIndex}].Value" type="text" value="" />
                                        </div>
                                        <div class="col-1 remove-detail-row">
                                            <button type="button" class="btn btn-lg"><i class="m-2 ti ti-trash"></i></button>
                                        </div>
                                    </div>`;

            if(detailRowIndex > 0){
                $(".detail-row").last().after(newDetailRowHtml);
            } else{
                var detailRowHeaderHtml = `
                                           <div class="row mb-2 text-center" id="detail-header">
                                               <div class="col-1">
                                               </div>
                                               <div class="col-5">
                                                   <label class="small">Título do detalhe</label>
                                               </div>
                                               <div class="col-5">
                                                   <label class="small">Descrição</label>
                                               </div>
                                               <div class="col-1">
                                               </div>
                                           </div>`;

                var newDetailRowHtml = detailRowHeaderHtml += newDetailRowHtml;
                $("#add-new-detail-row").prepend(newDetailRowHtml);
            }

        };

        function updateRowsIndexes(){
            var detailRowIndex = 0;

            $.each($(".detail-row"), function(){
                $(this).find(".row-number").html(`${detailRowIndex + 1}.`)
                $(this).find(".row-key").attr("name", `Details[${detailRowIndex}].Key`)
                $(this).find(".row-value").attr("name", `Details[${detailRowIndex}].Value`)

                detailRowIndex++;
            });


        }
    </script>
}