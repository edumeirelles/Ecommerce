@using System.Globalization
@model List<DAL.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Produtos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h1">Produtos</h1>
    <a href="@Url.Action("ProductDetails", "Product")" class="btn btn-primary"><i class="ti ti-plus"></i> Adicionar Novo produto</a>
</div>


<div class="row">
    @foreach (var i in Model)
    {
        <div class="col-3">
            <div class="card w-100" title="@($"Clique para editar o produto {Html.Raw(i.Title)}")">
                <div class="card-body">
                    <a href="@Url.Action("ProductDetails", "Products", new { id = i.Id })">
                        <div class="d-md-flex align-items-center">

                            <img src="@Url.Content(i.ProductImages.FirstOrDefault()?.ImagePath ?? "~/images/products/No_Image_Available.jpg")" class="product-image" />

                        </div>
                    </a>
                </div>
                <div class="card-footer">
                    <label class="card-title">@Html.Raw(i.Title)</label>
                    <div class="row">
                        <div class="d-inline-flex justify-content-between">
                            <span>$ @Html.Raw(i.Price.ToString("0.00", CultureInfo.CurrentCulture))</span>
                            <span>@Html.Raw(i.Stock) un.</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>